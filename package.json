{
  "name": "motion-harness-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kit harness para producir motion graphics con IA (Claude Code + HyperFrames) con branding configurable",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand": "node scripts/brand-apply.mjs",
    "brand:check": "node scripts/brand-apply.mjs --check",
    "brand:logo": "node scripts/placeholder-logo.mjs",
    "new": "node scripts/new-project.mjs",
    "build:roots": "node scripts/build-roots.mjs",
    "frames": "node scripts/frames.mjs",
    "render": "node scripts/render.mjs",
    "qa": "node scripts/qa.mjs",
    "loudnorm": "bash scripts/loudnorm.sh",
    "master": "bash scripts/master.sh",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.174"
  }
}
