{
  "name": "motion-harness-kit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Kit harness para producir motion graphics con IA (Claude Code + HyperFrames) con branding configurable",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand": "node scripts/brand-apply.mjs",
    "brand:check": "node scripts/brand-apply.mjs --all --check",
    "brand:new": "node scripts/brand-new.mjs",
    "brand:list": "node scripts/brand-list.mjs",
    "brand:compare": "node scripts/brand-compare.mjs",
    "brand:logo": "node scripts/placeholder-logo.mjs",
    "brandkit:new": "node scripts/brandkit-new.mjs",
    "brandkit:check": "node scripts/brandkit-check.mjs",
    "new": "node scripts/new-project.mjs",
    "build:roots": "node scripts/build-roots.mjs",
    "frames": "node scripts/frames.mjs",
    "render": "node scripts/render.mjs",
    "deliver": "node scripts/deliver.mjs",
    "qa": "node scripts/qa.mjs",
    "loudnorm": "bash scripts/loudnorm.sh",
    "master": "bash scripts/master.sh",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/doctor.mjs --fix",
    "selftest": "node scripts/selftest.mjs",
    "pipeline": "node scripts/pipeline.mjs"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.174"
  }
}
