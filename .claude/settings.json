      "Bash(npx hyperframes transcribe:*)",
      "Bash(npx hyperframes audio:*)",
      "Bash(ffprobe:*)"
    ],
    "ask": [
      "Bash(npx hyperframes add:*)",
      "Bash(npx hyperframes tts:*)",
      "Bash(npx skills add:*)",
      "Bash(npm install:*)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(npm exec:*)",
      "Bash(npx -y:*)",
      "Bash(npx --yes:*)",
      "Bash(claude plugin install:*)",
      "Bash(claude plugin marketplace add:*)",
      "Bash(npx skills:*)"
