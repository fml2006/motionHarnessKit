{
  "meta": {
    "name": "motion-tokens-default",
    "version": "1.0.0",
    "date": "2026-10-19",
    "companion_doc": "04-fundamentos-motion.md",
    "units": {
      "duration": "ms",
      "distance": "px @1920x1080 unless noted",
      "stagger": "ms",
      "frames": "f"
    },
    "default_fps": 30,
    "confidence_legend": {
      "official": "Sistema/estándar oficial (Material, Carbon, WCAG, SMPTE/EBU, NN/g, Netflix)",
      "secondary": "Fuentes de terceros coincidentes, no verificadas contra el original",
      "repo": "Reglas de los skills HyperFrames (hyperframes-animation / hyperframes-creative)",
      "practice": "Criterio de estudio; calibrar con renders reales"
    },
    "usage": "Pasar este JSON a la IA en el prompt. Usar nombres semánticos (ease.enter, duration.base). No inventar valores fuera de estos rangos sin justificarlo."
  },

  "fps": {
    "default": 30,
    "screen_recording": 60,
    "cinematic": 24,
    "frame_ms": { "24": 41.667, "25": 40, "30": 33.333, "60": 16.667 },
    "ms_to_frames_formula": "frames = round(ms * fps / 1000)"
  },

  "duration": {
