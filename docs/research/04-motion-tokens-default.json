  "easing": {
    "team_defaults": {
      "enter":            { "css": "cubic-bezier(0.165, 0.84, 0.44, 1)",  "gsap": "power3.out", "remotion": "Easing.bezier(0.165, 0.84, 0.44, 1)", "use": "default entrance (house)" },
      "enter-gentle":     { "css": "cubic-bezier(0.215, 0.61, 0.355, 1)", "gsap": "power2.out", "remotion": "Easing.bezier(0.215, 0.61, 0.355, 1)", "use": "secondary elements, strokes" },
      "enter-punch":      { "css": "cubic-bezier(0.19, 1, 0.22, 1)",      "gsap": "expo.out",   "remotion": "Easing.bezier(0.19, 1, 0.22, 1)", "use": "hero, slam, mask reveal, premium snap" },
      "enter-emphasized": { "css": "cubic-bezier(0.05, 0.7, 0.1, 1)",     "gsap": "CustomEase", "remotion": "Easing.bezier(0.05, 0.7, 0.1, 1)", "use": "M3 emphasized decelerate; expressive entrances" },
      "exit":             { "css": "cubic-bezier(0.55, 0.055, 0.675, 0.19)", "gsap": "power2.in", "remotion": "Easing.bezier(0.55, 0.055, 0.675, 0.19)", "use": "default exit" },
      "exit-soft":        { "css": "cubic-bezier(0.55, 0.085, 0.68, 0.53)", "gsap": "power1.in", "remotion": "Easing.bezier(0.55, 0.085, 0.68, 0.53)", "use": "press down, gentle exits" },
      "exit-hard":        { "css": "cubic-bezier(0.895, 0.03, 0.685, 0.22)", "gsap": "power3.in", "remotion": "Easing.bezier(0.895, 0.03, 0.685, 0.22)", "use": "exit into a velocity-matched cut" },
      "exit-emphasized":  { "css": "cubic-bezier(0.3, 0, 0.8, 0.15)",     "gsap": "CustomEase", "remotion": "Easing.bezier(0.3, 0, 0.8, 0.15)", "use": "M3 emphasized accelerate" },
      "move":             { "css": "cubic-bezier(0.2, 0, 0, 1)",          "gsap": "CustomEase", "remotion": "Easing.bezier(0.2, 0, 0, 1)", "use": "M3 standard; on-screen reposition" },
      "move-symmetric":   { "css": "cubic-bezier(0.645, 0.045, 0.355, 1)", "gsap": "power2.inOut", "remotion": "Easing.bezier(0.645, 0.045, 0.355, 1)", "use": "symmetric moves, push transitions" },
      "camera":           { "css": "cubic-bezier(0.77, 0, 0.175, 1)",     "gsap": "power3.inOut", "remotion": "Easing.bezier(0.77, 0, 0.175, 1)", "use": "virtual camera zoom/pan" },
      "ambient":          { "css": "cubic-bezier(0.445, 0.05, 0.55, 0.95)", "gsap": "sine.inOut", "remotion": "Easing.bezier(0.445, 0.05, 0.55, 0.95)", "use": "loops, Ken Burns, breathing (sparingly)" },
      "linear":           { "css": "linear", "gsap": "none", "remotion": "Easing.linear", "use": "typing, constant scroll, time-bound progress, data flow packets" },
      "step":             { "css": "steps(1)", "gsap": "steps(1)", "remotion": "Math.floor-based", "use": "caret blink, discrete swaps" },
      "overshoot-playful-RESTRICTED": { "css": "cubic-bezier(0.34, 1.56, 0.64, 1)", "gsap": "back.out(1.7)", "remotion": "Easing.bezier(0.34, 1.56, 0.64, 1)", "overshoot_pct": 10, "use": "ONLY explicitly playful register; never data, opacity, logos" }
    },
    "direction_rules": {
      "entering": ".out (decelerate)",
      "leaving": ".in (accelerate)",
      "moving_between_visible_positions": ".inOut",
      "confidence": "repo + official"
