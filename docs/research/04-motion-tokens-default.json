  "spring": {
    "formula": {
      "damping_ratio": "zeta = damping / (2 * sqrt(stiffness * mass))",
      "overshoot": "exp(-pi * zeta / sqrt(1 - zeta^2)) for zeta < 1"
    },
    "presets": {
      "settle": {
        "zeta": 1.0, "overshoot_pct": 0,
        "remotion": { "mass": 1, "stiffness": 100, "damping": 20 },
        "remotion_settle_99pct_ms": 660,
        "gsap_springEase": { "response": 0.4, "dampingFraction": 1.0, "approx_duration_ms": 590 },
        "swiftui": ".smooth (duration 0.5, bounce 0)",
        "use": "DEFAULT: product, enterprise, data-adjacent, serious tone"
      },
      "alive": {
        "zeta": 0.8, "overshoot_pct": 1.5,
        "remotion": { "mass": 1, "stiffness": 170, "damping": 21 },
        "gsap_springEase": { "response": 0.4, "dampingFraction": 0.82 },
        "swiftui": ".snappy (~bounce 0.15)",
        "use": "felt-not-seen settle; UI arrivals, cards, icons. Not on opacity/color/data"
      },
      "playful_RESTRICTED": {
        "zeta": 0.65, "overshoot_pct": 7,
        "remotion": { "mass": 1, "stiffness": 120, "damping": 14 },
        "gsap_springEase": { "response": 0.45, "dampingFraction": 0.65 },
        "swiftui": ".bouncy (~bounce 0.3)",
        "use": "ONLY explicitly playful brand/beat"
      },
      "remotion_default_WARNING": {
        "remotion": { "mass": 1, "stiffness": 100, "damping": 10 },
        "zeta": 0.5, "overshoot_pct": 16,
        "use": "Do not use unmodified for tech/brand work"
      }
    },
    "rules": [
      "Overshooting springs only on transforms; split opacity into its own power2.out tween",
      "Never overshoot numbers, data marks, logos, grid-aligned elements",
      "Prefer closed-form (seek-safe) springs in deterministic renders"
    ],
    "confidence": "remotion defaults official; derived values computed; presets repo/practice"
  },

